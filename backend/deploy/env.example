# Copy to  backend/env  on the server and fill in real values. NEVER commit the
# filled file (backend/env is gitignored).

# ── Production Django ─────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.career.tiesverse.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.career.tiesverse.com,https://career.tiesverse.com

# ── Data provider ─────────────────────────────────────────────────
TV_DATA_PROVIDER=cloudflare

# ── Cloudflare D1 / R2 ────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=career-tiesverse

# ── AWS SES (application confirmation emails) ─────────────────────
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
SES_CAREERS_FROM_EMAIL=careers@tiesverse.com
